# وصال — متغيرات البيئة (الخادم)
# انسخ هذا الملف إلى .env وعدّل القيم

# إلزامي في الإنتاج — ولّده بـ: openssl rand -hex 32
JWT_SECRET=

# بيئة التشغيل: development | production
NODE_ENV=development

# منفذ وعنوان الخادم
PORT=4000
HOST=0.0.0.0

# ملف قاعدة البيانات SQLite (المسار الافتراضي: data/wesal.db)
DB_FILE=

# صلاحية رمز الدخول
JWT_EXPIRES=7d

# الأصول المسموح لها بالوصول (افصل بفواصل)، * للتطوير فقط
CORS_ORIGINS=*

# مزوّد الرسائل الخارجية للتصعيد: log (يكتب في السجل) | webhook
SMS_PROVIDER=log
# عند اختيار webhook: عنوان الخدمة التي تستقبل {to, channel, message}
SMS_WEBHOOK_URL=

# دورة محرك الجدولة بالمللي ثانية (الافتراضي 20 ثانية)
SCHEDULER_INTERVAL_MS=20000

# إنشاء بيانات تجريبية عند أول تشغيل (عطّلها في الإنتاج)
SEED_DEMO=true

# حساب الإدارة الذي يُنشأ عند أول تشغيل
ADMIN_EMAIL=admin@wesal.app
ADMIN_PASSWORD=

# تقديم واجهة الويب المبنية (web/dist) من نفس الخادم في الإنتاج
SERVE_WEB_DIST=false
