# Production template for Vercel / GitHub Actions.
# Do not commit real secret values. Copy the names into GitHub Secrets/Variables and Vercel.

# ── Non-secret GitHub Actions Variables ──────────────────────
NODE_ENV=production
API_PREFIX=v1
PUBLIC_BASE_URL=https://your-vercel-domain.vercel.app
CORS_ORIGINS=https://your-vercel-domain.vercel.app

DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=10

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEV_MODE=false

INVITE_TTL_DAYS=14
WEB_CHECKIN_LINK_TTL_MINUTES=45

SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULE_GENERATION_WEEKS_AHEAD=3
DEFAULT_GRACE_PERIOD_MINUTES=90

NOTIFICATION_DRIVER=log
SMS_DRIVER=log
SMS_MAX_PER_DAY_PER_CONTACT=2

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10

AUDIT_ENABLED=true
LOG_LEVEL=log

# ── Secret GitHub Actions Secrets ────────────────────────────
# Vercel deployment credentials (GitHub only; not runtime app env):
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Runtime secrets that the workflow can sync to Vercel:
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
OTP_FIXED_DEV_CODE=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
