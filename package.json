{
  "name": "wesal",
  "version": "0.1.0",
  "private": true,
  "description": "وصال (WESAL) — تطبيق صلة الرحم والاطمئنان على الأحباب بانتظام",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:install": "npm --prefix tools/db install",
    "db:up": "npm --prefix tools/db start -- up",
    "db:down": "npm --prefix tools/db start -- down",
    "db:status": "npm --prefix tools/db start -- status",
    "migrate": "npm run migrate --workspace @wesal/api",
    "seed": "npm run seed --workspace @wesal/api",
    "api:dev": "npm run dev --workspace @wesal/api",
    "api:build": "npm run build --workspace @wesal/api",
    "api:start": "npm run start:prod --workspace @wesal/api",
    "api:test": "npm run test --workspace @wesal/api",
    "api:test:e2e": "npm run test:e2e --workspace @wesal/api",
    "api:lint": "npm run lint --workspace @wesal/api",
    "shared:build": "npm run build --workspace @wesal/shared",
    "shared:test": "npm run test --workspace @wesal/shared",
    "mobile:web": "npm run export:web --workspace @wesal/mobile",
    "mobile:start": "npm run start --workspace @wesal/mobile",
    "preview": "node scripts/preview-server.mjs",
    "test": "npm run shared:test && npm run api:test",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
